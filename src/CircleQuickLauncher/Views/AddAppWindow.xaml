<Window
    x:Class="CircleQuickLauncher.Views.AddAppWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CircleQuickLauncher — Add an app">

    <Grid Padding="24,16,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Add an app"
            Style="{StaticResource TitleTextBlockStyle}" />

        <TextBox
            x:Name="FilterBox"
            Grid.Row="1"
            PlaceholderText="Search your Start Menu…"
            MaxLength="64"
            TextChanged="FilterBox_TextChanged" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="20"
                    Height="20"
                    IsActive="False" />
                <TextBlock
                    x:Name="EmptyText"
                    Visibility="Collapsed"
                    Text="No matching applications found."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ListView
                x:Name="AppList"
                Grid.Row="1"
                MinHeight="320"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="AppList_ItemClick"
                SelectionChanged="AppList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="2">
                            <FontIcon Glyph="&#xE756;" FontSize="16" />
                            <TextBlock
                                Text="{Binding Name}"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBlock
            x:Name="SelectionText"
            Grid.Row="3"
            Text=""
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis" />

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8">
            <Button
                x:Name="CancelButton"
                Content="Cancel"
                Click="Cancel_Click" />
            <Button
                x:Name="AddButton"
                Content="Add"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="False"
                Click="Add_Click" />
        </StackPanel>
    </Grid>
</Window>
